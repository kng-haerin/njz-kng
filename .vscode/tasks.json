{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve website",
            "type": "shell",
            "command": "python3 -u -m http.server 8080 --bind 127.0.0.1",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Serving HTTP on .* port 8080",
                    "endsPattern": "Server stopped"
                }
            }
        }
    ]
}
